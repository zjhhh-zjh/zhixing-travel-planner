# ============== 环境变量模板 ==============
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# 各密钥获取方式见下方注释；真实密钥请勿提交到 Git。

# ============== LLM 配置 ==============
# 阿里云百炼（通义千问）API Key：https://bailian.console.aliyun.com/  → API-KEY 管理
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QWEN_MODEL_NAME=qwen-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============== LangSmith 配置（可选，用于 LLM 可观测/追踪） ==============
# https://smith.langchain.com/  → Settings → API Keys
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=zhixing-travel-planer
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ============== 数据库配置（PostgreSQL） ==============
# 本地开发默认值；生产环境请更换密码
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=travel_planner_db
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://travel_user:your_postgres_password@localhost:5432/travel_planner_db

# ============== Redis 配置 ==============
REDIS_HOST=localhost
REDIS_PORT=59000
REDIS_DB=8
REDIS_PASSWORD=your_redis_password

# ============== MCP 服务配置 ==============
# 高德开放平台（地图/天气/路线）：https://console.amap.com/  → 应用管理 → 新建 Web 服务 Key
AMAP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tavily 搜索 API：https://tavily.com/  → API Keys
TAVILY_API_KEY=tvly-dev-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞常准 Variflight 航班 API
VARIFLIGHT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AIGOHOTEL 酒店 MCP
AIGOHOTEL_MCP_API=mcp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NO_PROXY=mcp.aigohotel.com
no_proxy=mcp.aigohotel.com

# ============== 应用配置 ==============
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ============== JWT 密钥（请改为随机值） ==============
JWT_SECRET_KEY=your_jwt_secret

# ============== DeepSeek（行程压缩用） ==============
# https://platform.deepseek.com/  → API Keys
DEEP_SEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============== 腾讯地图（可选，后端方向 API 已改用高德） ==============
# https://lbs.qq.com/dev/console/application/mine
QQ_MAP_KEY=
